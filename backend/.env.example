NODE_ENV=development
PORT=3000
APP_NAME=Smart Tourist Safety Monitoring System

# PostgreSQL (preferred). For quick local demo without Postgres, set DB_TYPE=sqlite
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=smart_tourist

JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_SERVICE_URL=http://localhost:8001
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
DIGITAL_ID_CONTRACT_ADDRESS=

ADMIN_EMAIL=admin@smarttourist.local
ADMIN_PASSWORD=Admin@12345
LOCATION_RETENTION_DAYS=30
UPLOAD_DIR=uploads